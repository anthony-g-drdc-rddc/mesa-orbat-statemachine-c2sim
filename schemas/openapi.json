  "components": {
    "schemas": {
      "Body_create_run_api_v1_runs_post": {
        "properties": {
          "scenario": {
            "type": "string",
            "format": "binary",
            "title": "Scenario"
          },
          "config": {
            "type": "string",
            "title": "Config"
          },
          "mission": {
            "type": "string",
            "title": "Mission"
          }
        },
        "type": "object",
        "required": [
          "scenario",
          "config",
          "mission"
        ],
        "title": "Body_create_run_api_v1_runs_post"
      },
      "ControlInput": {
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1,
            "title": "Command Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "step",
              "pause",
              "resume",
              "stop"
            ],
            "title": "Action"
          },
          "expected_control_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Control Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command_id",
          "action",
          "expected_control_revision"
        ],
        "title": "ControlInput"
      },
      "DecisionAppliedOutput": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/DecisionOutput"
          },
          "applied_intents": {
            "items": {
              "$ref": "#/components/schemas/TransitionIntent"
            },
            "type": "array",
            "title": "Applied Intents"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPLIED",
              "STALE",
              "REJECTED"
            ],
            "title": "Outcome"
          },
          "resulting_commit_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resulting Commit Seq"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "applied_intents",
          "outcome",
          "resulting_commit_seq"
        ],
        "title": "DecisionAppliedOutput"
      },
      "DecisionChooseInput": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "expected_commit_seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Commit Seq"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "expected_commit_seq"
        ],
        "title": "DecisionChooseInput"
      },
      "DecisionOutput": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "provider_version": {
            "type": "string",
            "title": "Provider Version"
          },
          "selected_option_id": {
            "type": "string",
            "title": "Selected Option Id"
          },
          "random_draw_index": {
            "type": "integer",
            "title": "Random Draw Index"
          }
        },
        "type": "object",
        "required": [
          "decision_id",
          "provider_id",
          "provider_version",
          "selected_option_id",
          "random_draw_index"
        ],
        "title": "DecisionOutput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RestoreInput": {
        "properties": {
          "checkpoint_seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Checkpoint Seq"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checkpoint_seq"
        ],
        "title": "RestoreInput"
      },
      "RunCreateOutput": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "lifecycle": {
            "type": "string",
            "const": "READY",
            "title": "Lifecycle"
          },
          "control_revision": {
            "type": "integer",
            "title": "Control Revision"
          },
          "scenario_hash": {
            "type": "string",
            "title": "Scenario Hash"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "provider_version": {
            "type": "string",
            "title": "Provider Version"
          },
          "log_url": {
            "type": "string",
            "title": "Log Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "lifecycle",
          "control_revision",
          "scenario_hash",
          "provider_id",
          "provider_version",
          "log_url"
        ],
        "title": "RunCreateOutput"
      },
      "TransitionIntent": {
        "properties": {
          "machine_type": {
            "type": "string",
            "title": "Machine Type"
          },
          "machine_id": {
            "type": "string",
            "title": "Machine Id"
          },
          "expected_revision": {
            "type": "integer",
            "title": "Expected Revision"
          },
          "from_state": {
            "type": "string",
            "title": "From State"
          },
          "target_state": {
            "type": "string",
            "title": "Target State"
          }
        },
        "type": "object",
        "required": [
          "machine_type",
          "machine_id",
          "expected_revision",
          "from_state",
          "target_state"
        ],
        "title": "TransitionIntent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
