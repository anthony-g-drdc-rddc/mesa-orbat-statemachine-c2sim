        "machine_id": {
          "title": "Machine Id",
          "type": "string"
        },
        "expected_revision": {
          "title": "Expected Revision",
          "type": "integer"
        },
        "from_state": {
          "title": "From State",
          "type": "string"
        },
        "target_state": {
          "title": "Target State",
          "type": "string"
